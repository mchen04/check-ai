# ==============================================================================
# ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy to .env.local for development, .env for production
# [REQUIRED] = Must be set | [OPTIONAL] = Enables specific features
# ==============================================================================


# ==============================================================================
# CORE INFRASTRUCTURE [REQUIRED]
# ==============================================================================

# Supabase - https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (server-side only, for realtime broadcasts)
# Required for real-time verification status updates
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Public Website URL (for OAuth callbacks, emails, webhooks)
# Local: http://localhost:3001 | Production: https://yourdomain.com
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3001

# Log Level - Controls verbosity of server logs
# Options: debug | info | warn | error | fatal
# Development default: debug | Production default: info
LOG_LEVEL=info


# ==============================================================================
# AUTHENTICATION - OAUTH [OPTIONAL]
# ==============================================================================
# Enable social login with Google and/or GitHub

# Google OAuth - https://supabase.com/docs/guides/auth/social-login/auth-google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# GitHub OAuth - https://supabase.com/docs/guides/auth/social-login/auth-github
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=


# ==============================================================================
# PAYMENTS - STRIPE [REQUIRED FOR BILLING]
# ==============================================================================
# Required for subscription management and payments
# Get from: https://dashboard.stripe.com/apikeys

# Stripe Secret Key (sk_test_* for dev, sk_live_* for production)
STRIPE_SECRET_KEY=sk_test_...

# Stripe Publishable Key (pk_test_* for dev, pk_live_* for production)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Pricing Table ID - https://dashboard.stripe.com/pricing-tables
NEXT_PUBLIC_STRIPE_PRICING_TABLE_ID=prctbl_...

# Stripe Webhook Secret - https://dashboard.stripe.com/webhooks
# Development: Get from `stripe listen` CLI output (starts with whsec_)
# Production: Dashboard > Webhooks > Select endpoint > Reveal secret
STRIPE_WEBHOOK_SECRET=whsec_...


# ==============================================================================
# CACHING - UPSTASH REDIS [OPTIONAL]
# ==============================================================================
# Enables caching and rate limiting for improved performance
# Falls back gracefully if not configured
# Get from: https://console.upstash.com/

UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxx...


# ==============================================================================
# BACKGROUND JOBS - TRIGGER.DEV [RECOMMENDED]
# ==============================================================================
# Enables reliable background job processing with automatic retries
# Used for webhook delivery and batch processing
# Falls back to immediate execution if not configured
# Get from: https://cloud.trigger.dev

# Trigger.dev Secret Key (from your project settings)
# Format: tr_dev_... (development) or tr_prod_... (production)
TRIGGER_SECRET_KEY=


# ==============================================================================
# CRON JOB SECURITY [REQUIRED FOR PRODUCTION]
# ==============================================================================
# Secret token for authenticating Vercel Cron requests
# Generate with: openssl rand -base64 32
# CRITICAL: Set this in production or cron endpoints will reject all requests!
CRON_SECRET=


# ==============================================================================
# SECURITY - ENCRYPTION [REQUIRED FOR BYOK]
# ==============================================================================
# Required for encrypting user-provided API keys (BYOK feature)
# Uses AES-256-GCM encryption
#
# ⚠️  CRITICAL WARNINGS:
# 1. Generate a strong key: openssl rand -base64 32
# 2. NEVER CHANGE THIS KEY once you have encrypted data!
#    Changing it will make all encrypted API keys unrecoverable
# 3. Store this key securely (use secrets manager in production)
# 4. If compromised, all provider API keys must be re-encrypted
#
ENCRYPTION_KEY=


# ==============================================================================
# LLM PROVIDERS [OPTIONAL - At least one recommended]
# ==============================================================================
# Configure AI model providers for verification
# Users can also bring their own keys (BYOK) via the dashboard

# OpenAI - https://platform.openai.com/api-keys
# Required for: semantic verification method, embeddings
OPENAI_API_KEY=sk-...

# Anthropic Claude - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini - https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# DeepSeek - https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Groq (fast inference) - https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Together AI (open source models) - https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# Mistral AI - https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Cohere - https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# xAI (Grok) - https://console.x.ai/
XAI_API_KEY=

# Fireworks AI - https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=

# Cerebras - https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# Perplexity - https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# OpenRouter (unified API) - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Replicate - https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Azure OpenAI (enterprise) - Azure Portal > Azure OpenAI > Keys
AZURE_OPENAI_API_KEY=

# AWS Bedrock - IAM Console (requires additional AWS config)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1


# ==============================================================================
# EXTERNAL SERVICES [OPTIONAL]
# ==============================================================================

# Serper - Web search for tool-augmented verification
# Required for: tool verification method with real web search
# Falls back to mock results if not configured
# Get from: https://serper.dev/api-key
SERPER_API_KEY=

# Resend - Email service for invites and notifications
# Required for: team invitations, password reset emails
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...
