{
  "name": "check",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:trigger": "npx trigger.dev@4 dev",
    "build": "drizzle-kit migrate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stripe:setup": "tsx --env-file=.env stripeSetup.ts",
    "stripe:listen": "stripe listen --forward-to localhost:3001/webhook/stripe",
    "sdk:build": "npm run build -w packages/typescript-sdk && npm run build -w packages/langchain-ts",
    "sdk:test": "npm run test -w packages/typescript-sdk && npm run test -w packages/langchain-ts",
    "sdk:docs": "npm run docs -w packages/typescript-sdk && npm run docs -w packages/langchain-ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@aws-sdk/client-bedrock": "^3.965.0",
