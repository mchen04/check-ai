{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "out": "docs",
  "name": "@check/langchain",
  "readme": "README.md",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "sort": ["source-order"],
  "plugin": ["typedoc-plugin-markdown"],
  "theme": "markdown",
  "navigationLinks": {
    "Check.ai Docs": "https://check.ai/docs",
    "GitHub": "https://github.com/check-ai/check"
  }
}
