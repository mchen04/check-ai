{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "out": "docs",
  "name": "@shove/langchain",
  "readme": "README.md",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "sort": ["source-order"],
  "plugin": ["typedoc-plugin-markdown"],
  "theme": "markdown",
  "navigationLinks": {
    "Shove.ai Docs": "https://shove.ai/docs",
    "GitHub": "https://github.com/shove-ai/shove"
  }
}
