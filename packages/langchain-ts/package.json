{
  "name": "@check/langchain",
  "version": "0.1.0",
  "description": "LangChain integration for Check.ai - Auto-verify LLM outputs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "check",
    "langchain",
    "llm",
    "verification",
    "hallucination",
    "callback"
  ],
  "author": "Check.ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/check-ai/check.git",
    "directory": "packages/langchain-ts"
  },
  "bugs": {
    "url": "https://github.com/check-ai/check/issues"
  },
  "homepage": "https://check.ai/docs/sdk/langchain-typescript",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.1.0 <1.0.0"
  },
  "dependencies": {
    "@check/sdk": "^0.1.0",
    "drizzle-kit": "^0.18.1",
    "eslint-config-next": "16.1.1"
  },
  "devDependencies": {
    "@langchain/core": "^0.3.0",
    "@vitest/coverage-v8": "^4.0.16",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
